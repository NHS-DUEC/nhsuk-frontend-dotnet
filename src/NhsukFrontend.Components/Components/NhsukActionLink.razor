@namespace NhsukFrontend.Components
@* Port of nhsuk/components/action-link/template.njk *@
@Render.Link(new LinkOptions
{
    Id = Id,
    Href = Href,
    Type = Type,
    OpenInNewTab = OpenInNewTab ?? OpenInNewWindow,
    ClassName = "nhsuk-action-link",
    Classes = Classes,
    Attributes = Attributes,
    Variant = Variant,
    Element = Element,
}, Inner, AdditionalAttributes)

@code {
    private RenderFragment Inner =>
        @<text>
            <NhsukIcon Name="arrow-right-circle" />
            <span class="nhsuk-action-link__text">@Render.Content(text: Text, html: Html, caller: ChildContent)</span>
        </text>;
}
