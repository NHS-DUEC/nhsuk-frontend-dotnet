@namespace NhsukFrontend.Components
@* Port of nhsuk/components/button/template.njk *@
@if (_element == "input")
{
    <input @attributes="_attributes" />
}
else if (_element is "a" or "button")
{
    <NhsukElement Tag="@_element" Attributes="_attributes">
        @if (_hasIcon && Icon!.Placement is "start" or null) { @IconFragment }
        @if (_hasContent && _hasIcon) {<span class="nhsuk-button__content">@_content</span>}
        else { @_content }
        @if (_hasIcon && Icon!.Placement == "end") { @IconFragment }
    </NhsukElement>
}

@code {
    private static readonly string[] Variants = ["brand", "login", "reverse", "secondary", "secondary-solid", "warning"];

    private string _element = "button";
    private bool _hasIcon, _hasContent;
    private Attrs _attributes = new();
    private RenderFragment? _content;

    private RenderFragment IconFragment => Truthy(Icon?.Html)
        ? @<text>@((MarkupString)Icon!.Html!.Trim())</text>
        : @<NhsukIcon Name="@(Icon!.Name!)" />;

    protected override void OnParametersSet()
    {
        // className: false (or "") asks for no base class at all; a missing value uses the default.
        var noClassName = ClassName is "" or "false";
        var className = noClassName ? "nhsuk-button" : ClassName ?? "nhsuk-button";
        var classNames = noClassName ? "" : className;

        if (Variant is not null && Variants.Contains(Variant) && !Variants.Any(v => Contains(Classes, className + "--" + v)))
            classNames = (classNames + " " + className + "--" + Variant).Trim();
        if (Icon is not null && !Icon.IsFalse && !Contains(Classes, className + "--icon"))
            classNames = (classNames + " " + className + "--icon").Trim();
        if (Small == true && !Contains(Classes, className + "--small"))
            classNames = (classNames + " " + className + "--small").Trim();
        if (Truthy(Classes)) classNames = (classNames + " " + Classes).Trim();

        _element = Truthy(Element) ? Element!.ToLowerInvariant() : Truthy(Href) && !Truthy(Type) ? "a" : "button";

        // Upstream: `icon.html if icon.html else (nhsukIcon(icon.name) if icon.name)`
        _hasIcon = Truthy(Icon?.Html) || Truthy(Icon?.Name);
        _hasContent = ChildContent is not null || Truthy(Html) || Truthy(Text);

        // Warning buttons announce "Warning: " before their text, unless an aria-label replaces the text.
        _content = Render.Content(
            text: Text,
            html: Html,
            caller: ChildContent,
            visuallyHidden: Truthy(AriaLabel) ? null : new VisuallyHiddenOptions
            {
                Text = Contains(classNames, className + "--warning") ? "Warning" : VisuallyHiddenText,
                Placement = "start",
                Slots = new NhsukSlots { End = _hasContent ? new NhsukSlot { Text = ": " } : null },
            });

        var isFormControl = _element is "button" or "input";
        var hasTarget = Attributes?.ContainsKey("target") == true || AdditionalAttributes?.ContainsKey("target") == true;
        var hasRel = Attributes?.ContainsKey("rel") == true || AdditionalAttributes?.ContainsKey("rel") == true;
        var openInNewTab = OpenInNewTab == true
            || (Attributes is not null && Attributes.TryGetValue("target", out var target) && target as string == "_blank")
            || (AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("target", out var extra) && extra as string == "_blank");

        var attrs = new Attrs()
            .Optional("class", classNames.Length > 0 ? classNames : null)
            .Optional("id", Id)
            .Optional("name", isFormControl ? Name : null)
            .Add("data-module", "nhsuk-button")
            .Optional("data-prevent-double-click", PreventDoubleClick is bool b ? (b ? "true" : "false") : null);

        if (isFormControl)
        {
            attrs.Add("type", Default(Type, "submit"))
                .Optional("value", _element == "input" ? Text : Value)
                .Optional("disabled", Disabled)
                .Optional("aria-label", AriaLabel)
                .Optional("aria-disabled", Disabled == true ? "true" : null);
        }
        else if (_element == "a")
        {
            attrs.Add("href", Default(Href, "#"))
                .Optional("rel", openInNewTab && !hasRel ? "noopener noreferrer" : null)
                .Optional("target", openInNewTab && !hasTarget ? "_blank" : null)
                .Add("role", "button")
                .Add("draggable", "false")
                .Optional("aria-label", AriaLabel);
        }
        _attributes = attrs.AddUser(Attributes, AdditionalAttributes);
    }
}
