@namespace NhsukFrontend.Components
@* Port of nhsuk/components/card/action/template.njk: an action link or button in a card or summary list row. *@
@Render.Link(new LinkOptions
{
    Id = Id, Text = Text, Html = Html, VisuallyHidden = Hidden, Href = Href, Name = Name, Value = Value, Type = Type,
    OpenInNewTab = OpenInNewTab, Classes = Classes, Attributes = Attributes,
})

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Html { get; set; }
    [Parameter] public string? VisuallyHiddenText { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool? OpenInNewTab { get; set; }
    [Parameter] public string? Classes { get; set; }
    [Parameter] public NhsukAttributes? Attributes { get; set; }

    /// <summary>The parent card's heading, added to the visually hidden text.</summary>
    [Parameter] public string? HeadingText { get; set; }
    [Parameter] public string? HeadingHtml { get; set; }

    // "Change" becomes "Change name (Heading)" for screen readers when the card has a heading.
    private VisuallyHiddenOptions Hidden => !(Truthy(HeadingText) || Truthy(HeadingHtml))
        ? new VisuallyHiddenOptions { Text = VisuallyHiddenText }
        : new VisuallyHiddenOptions
        {
            Text = Truthy(HeadingText) ? ((VisuallyHiddenText ?? "") + " (" + HeadingText + ")").Trim() : null,
            Html = Truthy(HeadingHtml) ? ((VisuallyHiddenText is null ? "" : System.Net.WebUtility.HtmlEncode(VisuallyHiddenText)) + " (" + HeadingHtml + ")").Trim() : null,
        };
}
