@namespace NhsukFrontend.Components
@* Port of nhsuk/components/tabs/template.njk *@
<div @attributes="TabsAttributes">
    <NhsukHeading Text="@(VisuallyHiddenText ?? Title ?? "Contents")" Level="2" ClassName="nhsuk-tabs__heading" />
    @if (_items.Count > 0)
    {
        <ul class="nhsuk-tabs__list">
            @for (var i = 0; i < _items.Count; i++)
            {
                var item = _items[i];
                var index = i + 1;
                <li class="@("nhsuk-tabs__list-item" + (index == 1 ? " nhsuk-tabs__list-item--selected" : ""))">
                    @Render.Link(new LinkOptions
                    {
                        Href = "#" + PanelId(item, index), Text = item.Label?.Text, Html = item.Label?.Html,
                        ClassName = "nhsuk-tabs__tab", Attributes = item.Attributes,
                    })
                </li>
            }
        </ul>
        @for (var i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            var index = i + 1;
            <div class="@("nhsuk-tabs__panel" + (index > 1 ? " nhsuk-tabs__panel--hidden" : ""))" id="@PanelId(item, index)" @attributes="new Attrs().AddUser(item.Panel?.Attributes)">
                @if (Truthy(item.Panel?.Html)) { @((MarkupString)item.Panel!.Html!.Trim()) }
                else if (Truthy(item.Panel?.Text)) { <p>@item.Panel!.Text!.Trim()</p> }
            </div>
        }
    }
</div>

@code {
    // Empty items are dropped before numbering, so tab and panel IDs stay sequential.
    private List<TabsItemsItem> _items = [];

    protected override void OnParametersSet() => _items = (Items ?? []).OfType<TabsItemsItem>().ToList();

    // Without item.id, ids come from idPrefix, then the tabs id, then upstream's literal "undefined".
    private string PanelId(TabsItemsItem item, int index) => Truthy(item.Id) ? item.Id! : (Truthy(IdPrefix) ? IdPrefix : Truthy(Id) ? Id : "undefined") + "-" + index;

    private Attrs TabsAttributes => new Attrs()
        .Add("class", Append("nhsuk-tabs", Classes))
        .Optional("id", Id)
        .Add("data-module", "nhsuk-tabs")
        .AddUser(Attributes, AdditionalAttributes);
}
