@namespace NhsukFrontend.Components
@* Port of nhsuk/components/password-input/template.njk: an input with a show/hide button. *@
<NhsukInput Label="@Label" Hint="@Hint" ErrorMessage="@ErrorMessage" Id="@_id" Name="@Name" Value="@Value" Type="password"
            Prefix="@Prefix" Suffix="@Suffix" Code="@Code" Width="@Width" Large="@Large" Spellcheck="false"
            Autocomplete="@DefaultIfFalsy(Autocomplete, "current-password")" Autocapitalize="none" Disabled="@Disabled" DescribedBy="@DescribedBy"
            Classes="@Append("nhsuk-password-input__input nhsuk-js-password-input-input", Classes)" Attributes="@Attributes"
            AdditionalAttributes="@AdditionalAttributes"
            InputWrapper="@(InputWrapper is null ? null : new InputInputWrapperOptions { Classes = InputWrapper.Classes, Attributes = InputWrapper.Attributes })"
            FormGroup="@FormGroupOptions" AfterInputContent="@ToggleButton" />

@code {
    private string _id = "";

    protected override void OnParametersSet() => _id = Truthy(Id) ? Id! : Name ?? "";

    private InputFormGroupOptions FormGroupOptions
    {
        get
        {
            var attrs = new Attrs().Add("data-module", "nhsuk-password-input");
            I18n.Message(attrs, "show-password", ShowPasswordText ?? Button?.Text);
            I18n.Message(attrs, "hide-password", HidePasswordText);
            I18n.Message(attrs, "show-password-aria-label", ShowPasswordAriaLabel ?? ShowPasswordAriaLabelText ?? Button?.AriaLabel);
            I18n.Message(attrs, "hide-password-aria-label", HidePasswordAriaLabel ?? HidePasswordAriaLabelText);
            I18n.Message(attrs, "password-shown-announcement", PasswordShownAnnouncementText);
            I18n.Message(attrs, "password-hidden-announcement", PasswordHiddenAnnouncementText);
            attrs.AddUser(FormGroup?.Attributes);

            var attributes = new NhsukAttributes();
            foreach (var (name, value) in attrs) attributes[name] = value;
            return new InputFormGroupOptions
            {
                Classes = Truthy(FormGroup?.Classes) ? FormGroup!.Classes + " nhsuk-password-input" : "nhsuk-password-input",
                Attributes = attributes,
                BeforeInput = FormGroup?.BeforeInput is { } b ? new InputFormGroupBeforeInputOptions { Html = b.Html, Text = b.Text } : null,
            };
        }
    }

    private RenderFragment ToggleButton => @<text>
        <NhsukButton Text="@(ShowPasswordText ?? Button?.Text ?? "Show")"
                     AriaLabel="@(ShowPasswordAriaLabel ?? ShowPasswordAriaLabelText ?? Button?.AriaLabel ?? "Show password")"
                     Id="@Button?.Id" Href="@Button?.Href" Name="@Button?.Name" Value="@Button?.Value" Type="@DefaultIfFalsy(Button?.Type, "button")"
                     Icon="@Button?.Icon" Small="@(Button?.Small ?? Large != true)" PreventDoubleClick="@Button?.PreventDoubleClick"
                     Disabled="@(Button?.Disabled ?? Disabled)" Classes="@Append("nhsuk-password-input__toggle nhsuk-js-password-input-toggle", Button?.Classes)"
                     Attributes="@(new NhsukAttributes { ["aria-controls"] = _id, ["hidden"] = new AttributeValue(true, Optional: true) })"
                     Variant="@(Button?.Variant ?? "secondary")" />
        @if (FormGroup?.AfterInput is { } after) { @Render.HtmlOrText(after.Html?.Trim(), after.Text) }
    </text>;
}
