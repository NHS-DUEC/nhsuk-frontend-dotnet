@namespace NhsukFrontend.Components
@* Port of nhsuk/components/notification-banner/template.njk *@
<div @attributes="BannerAttributes">
    <div class="nhsuk-notification-banner__header">
        <NhsukHeading Id="@_titleId" Text="@(_title.Text ?? (_variant == "success" ? "Success" : "Important"))" Html="@_title.Html"
                      VisuallyHiddenText="@_title.VisuallyHiddenText" Level="@(_title.Level ?? 2)" ClassName="nhsuk-notification-banner__title"
                      Classes="@_title.Classes" Attributes="@_title.Attributes" />
    </div>
    <div class="nhsuk-notification-banner__content">
        @if (Heading is { } h)
        {
            <NhsukHeading Id="@h.Id" Text="@h.Text" Html="@h.Html" VisuallyHiddenText="@h.VisuallyHiddenText" Caption="@h.Caption" Href="@h.Href"
                          Level="@(h.Level ?? 3)" ClassName="nhsuk-notification-banner__heading" Classes="@h.Classes" Attributes="@h.Attributes" Element="@h.Element" />
        }
        @if (ChildContent is not null) { @ChildContent }
        else if (Truthy(Html)) { @((MarkupString)Html!.Trim()) }
        else if (Truthy(Text) && Heading is null) { <p class="nhsuk-notification-banner__heading">@Text!.Trim()</p> }
        else if (Truthy(Text)) { <p class="nhsuk-body">@Text!.Trim()</p> }
    </div>
</div>

@code {
    private string? _variant;
    private string _titleId = "";
    private NotificationBannerTitleOptions _title = new();

    protected override void OnParametersSet()
    {
        _variant = Truthy(Variant) ? Variant : Type;
        // A title object replaces the deprecated title* options; a title string only replaces the text.
        _title = Title is { IsShorthand: false } ? Title : new NotificationBannerTitleOptions
        {
            Id = TitleId,
            Text = Title?.Text ?? TitleText,
            Html = TitleHtml,
            Level = int.TryParse(TitleHeadingLevel, out var level) ? level : null,
        };
        _titleId = DefaultIfFalsy(_title.Id, "nhsuk-notification-banner-title");
    }

    private Attrs BannerAttributes
    {
        get
        {
            var classNames = Append("nhsuk-notification-banner", Classes);
            if (_variant == "success" && !Contains(Classes, "nhsuk-notification-banner--success")) classNames += " nhsuk-notification-banner--success";
            var role = Truthy(Role) ? Role : _variant == "success" ? "alert" : "region";
            return new Attrs()
                .Add("class", classNames)
                .Optional("id", Id)
                .Add("data-module", "nhsuk-notification-banner")
                .Optional("data-disable-auto-focus", DisableAutoFocus is bool b ? (b ? "true" : "false") : null)
                .Add("role", role)
                .Add("aria-labelledby", _titleId)
                .AddUser(Attributes, AdditionalAttributes);
        }
    }
}
