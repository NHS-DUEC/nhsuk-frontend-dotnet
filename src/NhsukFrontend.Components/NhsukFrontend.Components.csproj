<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="Generated/UpstreamVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NhsukFrontend.Components</RootNamespace>

    <!-- The version follows the nhsuk-frontend release it is generated from (see Generated/UpstreamVersion.props).
         Change the suffix for each release of this port; reset it to beta.1 when upstream moves on. -->
    <PackageId>nhsuk-frontend-dotnet</PackageId>
    <VersionPrefix>$(NhsukFrontendUpstreamVersion)</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <Title>NHS.UK frontend for .NET</Title>
    <Description>Community port of NHS.UK frontend for ASP.NET Core: tag helpers for Razor Pages and MVC, and Razor components for Blazor, rendering the same HTML as nhsuk-frontend. Not maintained by NHS England.</Description>
    <Authors>nhsuk-frontend-dotnet contributors</Authors>
    <Copyright>Copyright (c) 2026 nhsuk-frontend-dotnet contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/NHS-DUEC/nhsuk-frontend-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NHS-DUEC/nhsuk-frontend-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nhs;nhsuk;nhsuk-frontend;design-system;aspnetcore;razor;tag-helpers;blazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Serve the CSS, JS and images at a fixed path (NhsukFrontendAssets.ContentRoot), whatever the package is called. -->
    <StaticWebAssetBasePath>_content/NhsukFrontend.Components</StaticWebAssetBasePath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS0618: we deliberately read deprecated upstream options. CS1591: generated option docs cover the public API. -->
    <NoWarn>$(NoWarn);CS0618;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
