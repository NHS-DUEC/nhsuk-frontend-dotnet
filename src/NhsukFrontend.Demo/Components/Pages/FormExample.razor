@page "/examples/form"

<DemoPage Title="@(_submitted ? "Check your answers" : "Book an appointment")" Section="form">
    <BeforeContent><NhsukBackLink Href="/" /></BeforeContent>
    <ChildContent>
        @if (_submitted)
        {
            <NhsukHeading Size="l" Text="Check your answers" />
            <NhsukSummaryList Rows="@Model!.Summary("/examples/form")" />
            <NhsukInsetText Text="Nothing has been stored or sent. This is a Blazor static server-rendered form: every field is bound with For, and the errors come from DataAnnotations." />
            <NhsukButton Href="/examples/form" Text="Start again" Variant="secondary" />
        }
        else
        {
            <EditForm Model="Model" FormName="appointment" OnValidSubmit="() => _submitted = true" novalidate>
                <DataAnnotationsValidator />
                <NhsukValidationSummary For="() => Model" />

                <NhsukHeading Size="l" Text="Book an appointment" />
                <p>This page is a Blazor component. Each field names its model property with <code>For</code>; the name, value, label and error message are filled in from the form.</p>

                <NhsukInput For="() => Model!.FullName" Autocomplete="name" Spellcheck="false" />
                <NhsukInput For="() => Model!.NhsNumber" Hint="@("This is a 10 digit number, like 999 123 4567")"
                            Width="10" Inputmode="numeric" Code="true" Spellcheck="false" />
                <NhsukDateInput For="() => Model!.DateOfBirth" Hint="@("For example, 15 3 1984")" />
                <NhsukRadios For="() => Model!.Contact" Items="AppointmentRequest.ContactOptions" />
                <NhsukCheckboxes For="() => Model!.Needs" Items="AppointmentRequest.NeedOptions" Hint="@("Select all that apply")" />
                <NhsukCharacterCount For="() => Model!.Notes" Maxlength="200" />

                <NhsukButton Text="Continue" PreventDoubleClick="true" />
            </EditForm>
        }
    </ChildContent>
</DemoPage>

@code {
    [SupplyParameterFromForm(FormName = "appointment")] public AppointmentRequest? Model { get; set; }

    private bool _submitted;

    protected override void OnInitialized() => Model ??= new();
}
