{
  "$comment": "Components listed here get generated parameters, copied fixtures and parity checks. Add a component here, run `npm run sync`, then write its .razor markup.",
  "components": [
    "action-link",
    "back-link",
    "breadcrumb",
    "button",
    "caption",
    "card",
    "character-count",
    "checkboxes",
    "code",
    "contents-list",
    "date-input",
    "details",
    "do-dont-list",
    "error-message",
    "error-summary",
    "fieldset",
    "file-upload",
    "footer",
    "header",
    "heading",
    "hero",
    "hint",
    "images",
    "input",
    "inset-text",
    "label",
    "legend",
    "notification-banner",
    "pagination",
    "panel",
    "password-input",
    "radios",
    "scroll",
    "search-input",
    "select",
    "skip-link",
    "summary-list",
    "tables",
    "tabs",
    "tag",
    "task-list",
    "textarea",
    "warning-callout"
  ],
  "overrides": {
    "$comment": "Where an upstream template accepts more than its macro-options.json declares. Keyed by component/option/path.",
    "button/icon": {
      "shorthand": "name",
      "shorthandDefaults": {
        "placement": "start"
      },
      "keepFalse": true
    },
    "footer/navigation": {
      "list": true
    },
    "warning-callout/actions": {
      "$comment": "Passed straight through to the card, so it shares the card's type.",
      "type": "CardActionsOptions"
    },
    "label/heading": {
      "keepFalse": true
    },
    "legend/heading": {
      "keepFalse": true
    },
    "date-input/day": {
      "type": "DateInputItemsItem",
      "keepFalse": true
    },
    "date-input/month": {
      "type": "DateInputItemsItem",
      "keepFalse": true
    },
    "date-input/year": {
      "type": "DateInputItemsItem",
      "keepFalse": true
    },
    "tables/rows": {
      "list": true
    },
    "code/button": {
      "type": "ButtonOptions"
    },
    "password-input/button": {
      "type": "ButtonOptions"
    },
    "search-input/button": {
      "type": "ButtonOptions",
      "keepFalse": true
    },
    "password-input/prefix": {
      "type": "InputPrefixOptions"
    },
    "password-input/suffix": {
      "type": "InputSuffixOptions"
    },
    "hero/content": {
      "list": true
    },
    "hero/content/image": {
      "type": "ImagesOptions"
    },
    "task-list/items/title": {
      "type": "TaskListItemsHeadingOptions"
    },
    "contents-list/items/items": {
      "type": "List<ContentsListItemsItem?>"
    }
  },
  "additionalOptions": {
    "$comment": "Options an upstream template reads but its macro-options.json does not declare.",
    "contents-list/items": [
      {
        "name": "items",
        "type": "array",
        "required": false,
        "description": "Nested contents list items.",
        "released": "an undeclared option"
      }
    ],
    "pagination/items": [
      {
        "name": "classes",
        "type": "string",
        "required": false,
        "description": "Classes to add to the list item.",
        "released": "an undeclared option"
      }
    ]
  },
  "bindable": [
    "character-count",
    "checkboxes",
    "date-input",
    "input",
    "radios",
    "select",
    "textarea"
  ],
  "tagAliases": {
    "tables": [
      "table"
    ],
    "images": [
      "image"
    ]
  }
}
